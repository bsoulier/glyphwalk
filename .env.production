# Settings baked into the published site by `npm run build` (see docs/ONLINE.md). Both are public:
# they end up in the page. Left empty, playing online and usage counting are both off.

# Online server, e.g. wss://glyphwalk-online.<account>.workers.dev
VITE_ONLINE_URL=

# GoatCounter site code, e.g. glyphwalk for https://glyphwalk.goatcounter.com
VITE_GOATCOUNTER=
